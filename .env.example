# --- Shared ---
NODE_ENV=development

# --- PostgreSQL ---
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth Service ---
AUTH_SERVICE_PORT=4001
JWT_SECRET=changeme-generate-a-real-secret
OTP_TTL_SECONDS=300
SMS_PROVIDER_API_KEY=

# --- Messaging Service ---
MESSAGING_SERVICE_PORT=4002

# --- Media Service ---
MEDIA_SERVICE_PORT=4003
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=relay-media
R2_PUBLIC_BASE_URL=

# --- Call Signaling Service ---
CALL_SIGNALING_PORT=4004
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# --- Push Service ---
PUSH_SERVICE_PORT=4005
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
