# --- Shared ---
NODE_ENV=development

# --- PostgreSQL ---
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth Service ---
AUTH_SERVICE_PORT=4001
JWT_SECRET=changeme-generate-a-real-secret
OTP_TTL_SECONDS=300
SMS_PROVIDER_API_KEY=

# --- Messaging Service ---
MESSAGING_SERVICE_PORT=4002

# --- Media Service ---
MEDIA_SERVICE_PORT=4003
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=relay-media
R2_PUBLIC_BASE_URL=

# --- Call Signaling Service ---
CALL_SIGNALING_PORT=4004
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# --- Push Service ---
PUSH_SERVICE_PORT=4005
# JSON contents (not a file path) of a Firebase service account key, used by
# firebase-admin. Delivers to BOTH Android and iOS device tokens — see the
# README's "Push notifications" section for why one FCM integration covers
# both platforms here instead of a separate raw-APNs integration.
FCM_SERVICE_ACCOUNT_JSON=
# Configured in the Firebase console (Project Settings -> Cloud Messaging ->
# Apple app configuration), not read by this codebase directly — that's what
# lets FCM deliver to iOS via APNs under the hood.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# --- Internal service-to-service calls (messaging-service -> push-service) ---
# MVP-simple shared secret, same pattern as JWT_SECRET. In production these
# services also aren't reachable from outside Railway's private network, so
# this is a second layer, not the only one.
INTERNAL_SERVICE_SECRET=changeme-generate-a-real-secret
PUSH_SERVICE_URL=http://localhost:4005
