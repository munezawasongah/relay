{
  "expo": {
    "name": "Relay",
    "slug": "relay",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.jatelo.relay",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Relay needs access to your photos so you can share them in a chat."
      }
    },
    "android": {
      "package": "ke.jatelo.relay"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4001",
      "messagingBaseUrl": "http://localhost:4002",
      "mediaBaseUrl": "http://localhost:4003"
    }
  }
}
